# Required
TELEGRAM_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=123456789

# Ollama HTTP endpoint the bot talks to. Default = localhost.
OLLAMA_URL=http://127.0.0.1:11434

# Nano bridge (only used when you start the bridge from the bot)
NANO_BRIDGE_PORT=8765
# Chrome profile dir that already has Gemini Nano enabled + downloaded.
# See README "Prep Chrome for Nano" before starting the bridge for the first time.
NANO_CHROME_PROFILE=/home/user/.config/code-launcher-nano
# Optional — override the chrome/chromium binary playwright launches.
# NANO_CHROME_EXECUTABLE=/usr/bin/google-chrome

# Critical-alert thresholds (defaults shown)
TEMP_CRIT=85
VRAM_CRIT=95
DISK_CRIT=90
